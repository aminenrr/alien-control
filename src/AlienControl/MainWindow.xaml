<Window x:Class="AlienControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="clr-namespace:AlienControl"
        Title="Alien Controls"
        Icon="Assets/app.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <!-- Every look comes from the active theme dictionary (Themes/Legend.xaml or Themes/Fluent.xaml):
         this file only references keys. No blur. v0.8.2 micro-animations (window open/hide, hover, press,
         selection, flyout, profile chip) are one-shot Opacity / RenderTransform storyboards in Motion.cs and
         MainWindow.xaml.cs; "Reduce motion" in the gear menu skips all of them. -->

    <!-- 420 DIP card + 10 DIP margin for the shadow.
         v0.8.3 sharpness fix: the shadow lives on its OWN empty Border behind the card. An Effect on the card itself
         renders all text and icons through an offscreen bitmap (soft, grayscale, blurry at 125%). The card has an
         opaque background, so ClearTypeHint lets text use ClearType even in this transparent window.
         v0.8.8: open/hide slide the whole window natively (WindowSlide.cs), nothing inside it moves. -->
    <Grid x:Name="RootCard" Margin="10">
    <Border x:Name="CardShadow" Style="{DynamicResource WindowCard}" IsHitTestVisible="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black" RenderingBias="Performance" />
        </Border.Effect>
    </Border>
    <Border x:Name="CardBody" Style="{DynamicResource WindowCard}" RenderOptions.ClearTypeHint="Enabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource TopLine}" />

            <!-- Header -->
            <Grid Grid.Row="1">
                <Border Style="{DynamicResource HeaderPattern}" />
                <Border Style="{DynamicResource HeaderBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- left side gets whatever the buttons leave (never overlaps them) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                            <Image Source="Assets/logo.png" Style="{DynamicResource LogoImage}" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{DynamicResource Str.Title}" Style="{DynamicResource BrandText}" />
                            <Border Style="{DynamicResource ModelBadge}">
                                <TextBlock Text="m15 R7" Style="{DynamicResource ModelText}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- v1.1 beta.5 (Amine): preset button replaces the header chip; icon + color of the active preset -->
                            <Button x:Name="PresetButton" Style="{DynamicResource HeaderButton}" Click="PresetButton_Click" />
                            <Popup x:Name="PresetPopup" PlacementTarget="{Binding ElementName=PresetButton}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="PresetPopup_Closed">
                                <Border x:Name="PresetPanel" Style="{DynamicResource PopupPanel}" Width="196" Padding="6" UseLayoutRounding="True">
                                    <StackPanel x:Name="PresetList" />
                                </Border>
                            </Popup>
                            <Button Style="{DynamicResource HeaderButton}" Content="{DynamicResource Icon.Minimize}" Click="Minimize_Click" ToolTip="Minimize" />
                            <Button Style="{DynamicResource HeaderButton}" Content="{DynamicResource Icon.Close}" Click="Close_Click" ToolTip="Hide to tray" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2" Margin="{DynamicResource BodyMargin}">

                <!-- ===== Sensors ===== -->
                <Border Style="{DynamicResource StatsCard}">
                    <StackPanel>
                        <Border Style="{DynamicResource StatsGrid}">
                            <StackPanel>
                                <UniformGrid Columns="4">
                                    <Border Style="{DynamicResource StatCellFirst}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.Cpu}" Style="{DynamicResource StatLabel}" />
                                            <TextBlock Style="{DynamicResource StatValueLine}"><Run x:Name="CpuTempText" Text="--" Style="{DynamicResource StatValue}" /><Run Text=" °C" Style="{DynamicResource StatUnit}" /></TextBlock>
                                            <ProgressBar x:Name="CpuTempBar" Style="{DynamicResource StatBar}" Maximum="100" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource StatCell}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.CpuFan}" Style="{DynamicResource StatLabel}" />
                                            <TextBlock Style="{DynamicResource StatValueLine}"><Run x:Name="CpuFanText" Text="--" Style="{DynamicResource StatValue}" /><Run Text=" %" Style="{DynamicResource StatUnit}" /></TextBlock>
                                            <ProgressBar x:Name="CpuFanBar" Style="{DynamicResource StatBar}" Maximum="100" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource StatCell}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.Gpu}" Style="{DynamicResource StatLabel}" />
                                            <TextBlock Style="{DynamicResource StatValueLine}"><Run x:Name="GpuTempText" Text="--" Style="{DynamicResource StatValue}" /><Run Text=" °C" Style="{DynamicResource StatUnit}" /></TextBlock>
                                            <ProgressBar x:Name="GpuTempBar" Style="{DynamicResource StatBar}" Maximum="100" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{DynamicResource StatCell}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.GpuFan}" Style="{DynamicResource StatLabel}" />
                                            <TextBlock Style="{DynamicResource StatValueLine}"><Run x:Name="GpuFanText" Text="--" Style="{DynamicResource StatValue}" /><Run Text=" %" Style="{DynamicResource StatUnit}" /></TextBlock>
                                            <ProgressBar x:Name="GpuFanBar" Style="{DynamicResource StatBar}" Maximum="100" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <Border Style="{DynamicResource MemRow}">
                                    <UniformGrid Columns="2">
                                        <!-- v0.8.6: a Grid so the RAM card gets the same hover overlay as the buttons (RamHoverFx). -->
                                        <Grid x:Name="RamCard" Background="Transparent" Cursor="Hand"
                                              RenderTransformOrigin="0.5,0.5" fx:Motion.Interactive="True"
                                              MouseLeftButtonUp="RamCard_LeftClick" MouseRightButtonUp="RamCard_RightClick"
                                              ToolTip="Click: quick RAM clean · Right-click: deep clean (also clears the file cache)">
                                        <Border Style="{DynamicResource StatCellFirst}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{DynamicResource Str.Ram}" Style="{DynamicResource StatLabel}" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <ContentControl Width="11" Height="11" Margin="0,0,4,0" Focusable="False" IsTabStop="False"
                                                                        TextElement.Foreground="{DynamicResource AccentBrush}" Content="{DynamicResource Icon.Clean}" />
                                                        <TextBlock x:Name="CleanText" Text="{DynamicResource Str.Clean}" Style="{DynamicResource CleanText}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Style="{DynamicResource StatValueLine}"><Run x:Name="RamText" Text="--" Style="{DynamicResource StatValue}" /><Run x:Name="RamTextUnit" Text=" / -- GB" Style="{DynamicResource StatUnit}" /></TextBlock>
                                                <ProgressBar x:Name="RamBar" Style="{DynamicResource StatBar}" Maximum="100" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="RamHoverFx" Background="{DynamicResource HoverFxBrush}" CornerRadius="3" Opacity="0" IsHitTestVisible="False" />
                                        </Grid>
                                        <Border Style="{DynamicResource StatCell}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Str.Vram}" Style="{DynamicResource StatLabel}" />
                                                <TextBlock Style="{DynamicResource StatValueLine}"><Run x:Name="VramText" Text="--" Style="{DynamicResource StatValue}" /><Run x:Name="VramTextUnit" Text=" / -- GB" Style="{DynamicResource StatUnit}" /></TextBlock>
                                                <ProgressBar x:Name="VramBar" Style="{DynamicResource StatBar}" Maximum="100" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Power readout: hidden until a source answers; each part hides on its own -->
                        <Border x:Name="PwrRow" Style="{DynamicResource PwrRow}" Visibility="Collapsed"
                                ToolTip="CPU: Intel DTT RAPL counter · GPU: NVIDIA NVML (plugged in only) · Total: battery discharge (on battery only)">
                            <Grid Style="{DynamicResource PwrGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="PWR" Style="{DynamicResource PwrItem}" Visibility="{DynamicResource LegendOnly}" />
                                    <ContentControl Width="14" Height="14" Margin="0,0,6,0" Focusable="False" IsTabStop="False"
                                                    Visibility="{DynamicResource FluentOnly}" TextElement.Foreground="{DynamicResource AccentBrush}"
                                                    Content="{DynamicResource Icon.Bolt}" />
                                </Grid>
                                <TextBlock x:Name="PwrCpu" Grid.Column="2" Style="{DynamicResource PwrItem}">CPU <Run x:Name="PwrCpuValue" Text="--" Style="{DynamicResource PwrValue}" /></TextBlock>
                                <TextBlock x:Name="PwrDot1" Grid.Column="4" Text="·" Style="{DynamicResource PwrItem}" />
                                <TextBlock x:Name="PwrGpu" Grid.Column="6" Style="{DynamicResource PwrItem}">GPU <Run x:Name="PwrGpuValue" Text="--" Style="{DynamicResource PwrValue}" /></TextBlock>
                                <TextBlock x:Name="PwrDot2" Grid.Column="8" Text="·" Style="{DynamicResource PwrItem}" />
                                <TextBlock x:Name="PwrTotal" Grid.Column="10" Style="{DynamicResource PwrItem}">Total <Run x:Name="PwrTotalValue" Text="--" Style="{DynamicResource PwrTotal}" /></TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 01 Performance mode ===== -->
                <Border Style="{DynamicResource SectionPanel}">
                    <StackPanel>
                        <Grid Style="{DynamicResource SectionHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="01" Style="{DynamicResource SectionNum}" />
                            <ContentControl Grid.Column="1" Style="{DynamicResource SectionIcon}" Content="{DynamicResource Icon.Activity}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str.Perf}" Style="{DynamicResource SectionTitle}" />
                            <Border Grid.Column="3" Style="{DynamicResource SectionLine}" />
                            <TextBlock x:Name="PowerHint" Grid.Column="4" Style="{DynamicResource SectionHint}" />
                        </Grid>
                        <Border Style="{DynamicResource Track}">
                            <UniformGrid Columns="5">
                                <RadioButton x:Name="ModeBattery" GroupName="Mode" Style="{DynamicResource ModeButton}" Click="Mode_Click"
                                             Tag="{DynamicResource Icon.Battery}" Content="Battery" ToolTip="Battery Saver (power index 3, a5)" />
                                <RadioButton x:Name="ModeQuiet" GroupName="Mode" Style="{DynamicResource ModeButton}" Click="Mode_Click"
                                             Tag="{DynamicResource Icon.Quiet}" Content="Quiet" />
                                <RadioButton x:Name="ModeBalanced" GroupName="Mode" Style="{DynamicResource ModeButton}" Click="Mode_Click"
                                             Tag="{DynamicResource Icon.Balanced}" Content="Balanced" />
                                <RadioButton x:Name="ModePerformance" GroupName="Mode" Style="{DynamicResource ModeButton}" Click="Mode_Click"
                                             Tag="{DynamicResource Icon.Performance}" Content="Performance" />
                                <RadioButton x:Name="ModeGMode" GroupName="Mode" Style="{DynamicResource GModeButton}" Click="Mode_Click"
                                             Tag="{DynamicResource Icon.GMode}" Content="G-Mode" ToolTip="G-Mode · the G-key (F1) toggles it" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 02 GPU mode ===== -->
                <Border x:Name="GpuSection" Style="{DynamicResource SectionPanel}">
                    <StackPanel>
                        <Grid Style="{DynamicResource SectionHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="02" Style="{DynamicResource SectionNum}" />
                            <ContentControl Grid.Column="1" Style="{DynamicResource SectionIcon}" Content="{DynamicResource Icon.Gpu}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str.GpuMode}" Style="{DynamicResource SectionTitle}" />
                            <Border Grid.Column="3" Style="{DynamicResource SectionLine}" />
                            <TextBlock x:Name="GpuHint" Grid.Column="4" Style="{DynamicResource SectionHint}" Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                        <Border Style="{DynamicResource Track}">
                            <!-- 1.2.0-beta.2: iGPU only (pnputil, NVIDIA on Optimus only) / Advanced Optimus / Ultimate. NVIDIA's Auto / Optimus / GPU only stay in its tray popup. -->
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="GpuIgpu" GroupName="Gpu" Style="{DynamicResource ModeButton}" Click="GpuMode_Click"
                                             Tag="{DynamicResource Icon.IGpu}" Content="iGPU only" ToolTip="Turns the RTX off (Intel only). Needs NVIDIA set to Optimus." />
                                <RadioButton x:Name="GpuOptimus" GroupName="Gpu" Style="{DynamicResource ModeButton}" Click="GpuMode_Click" IsChecked="True"
                                             Tag="{DynamicResource Icon.Optimus}" Content="Advanced Optimus" ToolTip="Intel + RTX. Pick Auto / Optimus / GPU only from NVIDIA's tray icon." />
                                <RadioButton x:Name="GpuUltimate" GroupName="Gpu" Style="{DynamicResource ModeButton}" Click="GpuMode_Click"
                                             Tag="{DynamicResource Icon.Ultimate}" Content="Ultimate" ToolTip="Dell BIOS: Intel GPU off, the RTX drives everything. Needs a restart." />
                            </UniformGrid>
                        </Border>
                        <!-- 1.2.0-beta.2: why iGPU only / Ultimate is locked, or that the RTX is off -->
                        <TextBlock x:Name="GpuNote" Style="{DynamicResource FooterText}" TextWrapping="Wrap" Margin="2,8,2,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ===== 03 GPU overclock (v0.9.7): NVML clock offsets, G-Mode on AC only, 20 s keep-or-revert ===== -->
                <Border x:Name="OcSection" Style="{DynamicResource SectionPanel}">
                    <StackPanel>
                        <Grid Style="{DynamicResource SectionHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="03" Style="{DynamicResource SectionNum}" />
                            <ContentControl Grid.Column="1" Style="{DynamicResource SectionIcon}" Content="{DynamicResource Icon.GMode}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str.GpuOc}" Style="{DynamicResource SectionTitle}" />
                            <Border Grid.Column="3" Style="{DynamicResource SectionLine}" />
                            <TextBlock x:Name="OcHint" Grid.Column="4" Style="{DynamicResource SectionHint}" />
                        </Grid>
                        <Border Style="{DynamicResource LightPanel}">
                            <StackPanel>
                                <!-- v0.9.7 (Amine): Core and Memory side by side so the window stays short -->
                                <Grid x:Name="OcBody">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid>
                                            <TextBlock Text="Core" Style="{DynamicResource BodyText}" />
                                            <TextBlock x:Name="OcCoreValue" Text="+200 MHz" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                       Style="{DynamicResource BodyText}" Foreground="{DynamicResource AccentBrush}" />
                                        </Grid>
                                        <Slider x:Name="OcCoreSlider" Style="{DynamicResource LightSlider}" Margin="0,6,0,0" Minimum="0" Maximum="300" Value="200"
                                                TickFrequency="25" IsSnapToTickEnabled="True" SmallChange="25" LargeChange="25" IsMoveToPointEnabled="True"
                                                ValueChanged="Oc_Changed" ToolTip="Core offset, 0 to +300 MHz in 25 MHz steps" />
                                        <Grid Margin="0,1,0,0">
                                            <TextBlock Text="0" Style="{DynamicResource ValueSmall}" />
                                            <TextBlock Text="300" HorizontalAlignment="Right" Style="{DynamicResource ValueSmall}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Grid>
                                            <TextBlock Text="Memory" Style="{DynamicResource BodyText}" />
                                            <TextBlock x:Name="OcMemValue" Text="+200 MHz" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                       Style="{DynamicResource BodyText}" Foreground="{DynamicResource AccentBrush}" />
                                        </Grid>
                                        <Slider x:Name="OcMemSlider" Style="{DynamicResource LightSlider}" Margin="0,6,0,0" Minimum="0" Maximum="300" Value="200"
                                                TickFrequency="25" IsSnapToTickEnabled="True" SmallChange="25" LargeChange="25" IsMoveToPointEnabled="True"
                                                ValueChanged="Oc_Changed" ToolTip="Memory offset, 0 to +300 MHz in 25 MHz steps (AWCC scale)" />
                                        <Grid Margin="0,1,0,0">
                                            <TextBlock Text="0" Style="{DynamicResource ValueSmall}" />
                                            <TextBlock Text="300" HorizontalAlignment="Right" Style="{DynamicResource ValueSmall}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <!-- one row: Reset · Active · Apply, or during a test Revert · countdown · Keep -->
                                <Grid Margin="0,10,0,0">
                                    <Button x:Name="OcResetButton" Style="{DynamicResource GhostButton}" HorizontalAlignment="Left" MinWidth="76"
                                            Content="Reset" Click="OcReset_Click" ToolTip="Back to stock clocks (+0 / +0)" />
                                    <TextBlock x:Name="OcActive" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource ValueSmall}" />
                                    <StackPanel x:Name="OcConfirm" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="{DynamicResource Str.OcKeep}" HorizontalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource OcWarnBrush}" Style="{DynamicResource ValueSmall}" />
                                        <TextBlock x:Name="OcCountdown" HorizontalAlignment="Center" Margin="0,2,0,0" Style="{DynamicResource ValueSmall}" />
                                    </StackPanel>
                                    <Button x:Name="OcApplyButton" Style="{DynamicResource GhostButton}" HorizontalAlignment="Right" MinWidth="76"
                                            Content="Apply" Foreground="{DynamicResource AccentBrush}" Click="OcApply_Click"
                                            ToolTip="Try these offsets: keep them within 20 s or they go back to +0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 04 Refresh rate ===== -->
                <Border x:Name="RefreshSection" Style="{DynamicResource SectionPanel}">
                    <StackPanel>
                        <Grid Style="{DynamicResource SectionHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="04" Style="{DynamicResource SectionNum}" />
                            <ContentControl Grid.Column="1" Style="{DynamicResource SectionIcon}" Content="{DynamicResource Icon.Display}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str.Refresh}" Style="{DynamicResource SectionTitle}" />
                            <Border Grid.Column="3" Style="{DynamicResource SectionLine}" />
                            <TextBlock x:Name="RefreshHint" Grid.Column="4" Style="{DynamicResource SectionHint}" />
                        </Grid>
                        <Border Style="{DynamicResource Track}">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="Hz60" GroupName="Hz" Tag="{x:Null}" Content="60 Hz" Style="{DynamicResource SegButton}" Click="Refresh_Click" />
                                <RadioButton x:Name="Hz240" GroupName="Hz" Tag="{x:Null}" Content="240 Hz" Style="{DynamicResource SegButton}" Click="Refresh_Click" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 05 CPU boost (AC) ===== -->
                <Border x:Name="CpuSection" Style="{DynamicResource SectionPanelTop}">
                    <StackPanel>
                        <Grid Style="{DynamicResource SectionHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="05" Style="{DynamicResource SectionNum}" />
                            <ContentControl Grid.Column="1" Style="{DynamicResource SectionIcon}" Content="{DynamicResource Icon.Cpu}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str.CpuBoost}" Style="{DynamicResource SectionTitle}" />
                            <Border Grid.Column="3" Style="{DynamicResource SectionLine}" />
                            <TextBlock Grid.Column="4" Text="{DynamicResource Str.CpuBoostHint}" Style="{DynamicResource SectionHint}" />
                        </Grid>
                        <Border Style="{DynamicResource Track}">
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="CpuOff" GroupName="Cpu" CommandParameter="0" Content="Off" Style="{DynamicResource SegButton}" Click="Cpu_Click" />
                                <RadioButton x:Name="CpuOn" GroupName="Cpu" CommandParameter="1" Content="On" Style="{DynamicResource SegButton}" Click="Cpu_Click" />
                                <RadioButton x:Name="CpuEfficient" GroupName="Cpu" CommandParameter="3" Content="Efficient" Style="{DynamicResource SegButton}" Click="Cpu_Click" ToolTip="Boosts only when worth it, capped at 3.0 GHz (less heat and fan noise)" />
                                <RadioButton x:Name="CpuAggressive" GroupName="Cpu" CommandParameter="2" Content="Aggressive" Style="{DynamicResource SegButton}" Click="Cpu_Click" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 06 Fans ===== -->
                <Border x:Name="FanSection" Style="{DynamicResource SectionPanelBottom}">
                    <StackPanel>
                        <Grid Style="{DynamicResource SectionHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="06" Style="{DynamicResource SectionNum}" />
                            <ContentControl Grid.Column="1" Style="{DynamicResource SectionIcon}" Content="{DynamicResource Icon.Fan}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str.Fans}" Style="{DynamicResource SectionTitle}" />
                            <Border Grid.Column="3" Style="{DynamicResource SectionLine}" />
                            <TextBlock x:Name="FanHint" Grid.Column="4" Style="{DynamicResource SectionHint}" />
                        </Grid>
                        <Border Style="{DynamicResource Track}">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="FanAuto" GroupName="Fan" Tag="{x:Null}" Content="Auto" IsChecked="True" Style="{DynamicResource SegButton}" Click="Fan_Click" />
                                <RadioButton x:Name="FanMax" GroupName="Fan" Tag="{x:Null}" Content="Max Boost" Style="{DynamicResource SegButton}" Click="Fan_Click" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== 07 Lighting ===== -->
                <Border Style="{DynamicResource SectionPanel}">
                    <StackPanel>
                        <Grid Style="{DynamicResource SectionHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="07" Style="{DynamicResource SectionNum}" />
                            <ContentControl Grid.Column="1" Style="{DynamicResource SectionIcon}" Content="{DynamicResource Icon.Light}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str.Lighting}" Style="{DynamicResource SectionTitle}" />
                            <Border Grid.Column="3" Style="{DynamicResource SectionLine}" />
                            <TextBlock x:Name="BrightnessHint" Grid.Column="4" Style="{DynamicResource SectionHint}" />
                        </Grid>
                        <Border Style="{DynamicResource LightPanel}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton GroupName="Swatch" Style="{DynamicResource Swatch}" Background="#00E5FF" Tag="0,229,255" Click="Color_Click" ToolTip="Cyan" />
                                        <RadioButton GroupName="Swatch" Style="{DynamicResource Swatch}" Background="#7C4DFF" Tag="124,77,255" Click="Color_Click" ToolTip="Purple" />
                                        <RadioButton GroupName="Swatch" Style="{DynamicResource Swatch}" Background="#FF4D6A" Tag="255,77,106" Click="Color_Click" ToolTip="Red" />
                                        <RadioButton GroupName="Swatch" Style="{DynamicResource Swatch}" Background="#3CFF7A" Tag="60,255,122" Click="Color_Click" ToolTip="Green" />
                                        <RadioButton GroupName="Swatch" Style="{DynamicResource Swatch}" Background="#FFFFFF" Tag="255,255,255" Click="Color_Click" ToolTip="White" />
                                        <RadioButton x:Name="CustomSwatch" GroupName="Swatch" Style="{DynamicResource Swatch}" Click="CustomSwatch_Click" ToolTip="Custom color">
                                            <RadioButton.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF0000" Offset="0" />
                                                    <GradientStop Color="#FFFF00" Offset="0.2" />
                                                    <GradientStop Color="#00FF00" Offset="0.4" />
                                                    <GradientStop Color="#00FFFF" Offset="0.6" />
                                                    <GradientStop Color="#0000FF" Offset="0.8" />
                                                    <GradientStop Color="#FF00FF" Offset="1" />
                                                </LinearGradientBrush>
                                            </RadioButton.Background>
                                        </RadioButton>
                                        <Popup x:Name="CustomPopup" PlacementTarget="{Binding ElementName=CustomSwatch}" Placement="Top"
                                               StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                                            <Border Style="{DynamicResource PopupPanel}" Width="280" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,10">
                                                        <TextBlock Text="Custom color" Style="{DynamicResource PopupTitle}" />
                                                        <Border x:Name="CustomPreview" Width="40" Height="22" CornerRadius="4" HorizontalAlignment="Right"
                                                                BorderBrush="#30FFFFFF" BorderThickness="1" Background="#00E5FF" />
                                                    </Grid>
                                                    <TextBlock Text="Hue" Style="{DynamicResource BodyText}" />
                                                    <Border CornerRadius="5" Height="10" Margin="6,4,6,0">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#FF0000" Offset="0" />
                                                                <GradientStop Color="#FFFF00" Offset="0.1667" />
                                                                <GradientStop Color="#00FF00" Offset="0.3333" />
                                                                <GradientStop Color="#00FFFF" Offset="0.5" />
                                                                <GradientStop Color="#0000FF" Offset="0.6667" />
                                                                <GradientStop Color="#FF00FF" Offset="0.8333" />
                                                                <GradientStop Color="#FF0000" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Slider x:Name="HueSlider" Style="{DynamicResource LightSlider}" Minimum="0" Maximum="360" Value="186" IsMoveToPointEnabled="True" ValueChanged="CustomColor_Changed" />
                                                    <TextBlock Text="Saturation" Style="{DynamicResource BodyText}" Margin="0,6,0,0" />
                                                    <Slider x:Name="SatSlider" Style="{DynamicResource LightSlider}" Minimum="0" Maximum="100" Value="100" IsMoveToPointEnabled="True" ValueChanged="CustomColor_Changed" />
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="R" Style="{DynamicResource BodyText}" Margin="0,0,6,0" />
                                                        <TextBox x:Name="RBox" Grid.Column="1" MaxLength="3" Margin="0,0,8,0" TextChanged="Rgb_Changed" />
                                                        <TextBlock Grid.Column="2" Text="G" Style="{DynamicResource BodyText}" Margin="0,0,6,0" />
                                                        <TextBox x:Name="GBox" Grid.Column="3" MaxLength="3" Margin="0,0,8,0" TextChanged="Rgb_Changed" />
                                                        <TextBlock Grid.Column="4" Text="B" Style="{DynamicResource BodyText}" Margin="0,0,6,0" />
                                                        <TextBox x:Name="BBox" Grid.Column="5" MaxLength="3" TextChanged="Rgb_Changed" />
                                                    </Grid>
                                                    <Button Content="Apply" HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="CustomApply_Click" Style="{DynamicResource GhostButton}" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    <Button Style="{DynamicResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="LightsOff_Click" ToolTip="Lights off">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{DynamicResource ButtonIcon}" Content="{DynamicResource Icon.Power}" />
                                            <TextBlock Text="Off" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid x:Name="LightFxRow" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1.25*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="EffectBox" Style="{DynamicResource FxCombo}" ToolTip="Lighting effect" SelectionChanged="Effect_Changed">
                                        <ComboBoxItem Content="Static" Tag="0" />
                                        <ComboBoxItem Content="Breathing" Tag="2" />
                                        <ComboBoxItem Content="Wave" Tag="3" />
                                        <ComboBoxItem Content="Dual-color wave" Tag="4" />
                                        <ComboBoxItem Content="Pulse" Tag="8" />
                                        <ComboBoxItem Content="Mixed pulse" Tag="9" />
                                        <ComboBoxItem Content="Night Rider" Tag="10" />
                                        <ComboBoxItem Content="Laser" Tag="11" />
                                        <ComboBoxItem Content="Spectrum" Tag="100" />
                                        <ComboBoxItem Content="Rainbow wave" Tag="101" />
                                    </ComboBox>
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BrightnessSlider" Style="{DynamicResource LightSlider}" Minimum="0" Maximum="100" Value="80"
                                                IsMoveToPointEnabled="True" PreviewMouseUp="Brightness_Commit" ValueChanged="Brightness_Changed" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BrightnessValue" Grid.Column="1" Text="80%" Style="{DynamicResource ValueSmall}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- v1.1: status on the left, version on the right (the footer center holds the view button) -->
                <Grid Margin="2,8,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="VersionText" Grid.Column="1" Text="v0.8.5" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource VersionText}" />
                </Grid>
            </StackPanel>

            <!-- Footer: Run on startup · version · settings + Quit -->
            <Border Grid.Row="3" Style="{DynamicResource FooterBar}">
                <Grid>
                    <!-- v1.1 beta.3: three columns so the view button never touches "Run on startup" (Fluent text is wider) -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="StartupToggle" Style="{DynamicResource ToggleBox}" Click="Startup_Click" VerticalAlignment="Center" />
                        <TextBlock Text="Run on startup" Margin="9,0,0,0" Style="{DynamicResource FooterText}" />
                    </StackPanel>
                    <!-- v1.1: compact / full view switch (tray + F3 open compact, F4 opens full) -->
                    <Button x:Name="ViewButton" Grid.Column="1" Style="{DynamicResource GhostButton}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="8,0" Click="ViewButton_Click" ToolTip="Switch between the compact and the full view">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="ViewButtonIcon" Width="9" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, ElementName=ViewButtonText}" Data="M0,4 L4,0 L8,4 M0,10 L4,14 L8,10" />
                            <TextBlock x:Name="ViewButtonText" Text="Full menu" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="SettingsButton" Style="{DynamicResource GhostButton}" Padding="7,5" Margin="0,0,6,0" Click="Settings_Click" ToolTip="Settings">
                            <ContentControl Style="{DynamicResource ButtonIcon}" Margin="0" Content="{DynamicResource Icon.Settings}" />
                        </Button>
                        <Button Style="{DynamicResource GhostButton}" Click="Quit_Click" ToolTip="Quit Alien Controls">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{DynamicResource ButtonIcon}" Content="{DynamicResource Icon.Power}" />
                                <TextBlock Text="Quit" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Settings flyout -->
                    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Top"
                           StaysOpen="True" AllowsTransparency="True" VerticalOffset="-8" HorizontalOffset="-230">
                        <!-- v0.8.2: StaysOpen=True so closing can fade/slide out; MainWindow closes it on an outside click,
                             on deactivate, on hide and on minimize. -->
                        <Border x:Name="SettingsPanel" Style="{DynamicResource PopupPanel}" Width="290" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.Settings}" Style="{DynamicResource PopupTitle}" Margin="0,0,0,12" />

                                <TextBlock Text="{DynamicResource Str.Theme}" Style="{DynamicResource BodyText}" Margin="0,0,0,6" />
                                <Border Style="{DynamicResource Track}" Margin="0">
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="ThemeLegend" GroupName="Theme" Tag="{x:Null}" Content="Legend" Style="{DynamicResource SegButton}" Click="Theme_Click" />
                                        <RadioButton x:Name="ThemeFluent" GroupName="Theme" Tag="{x:Null}" Content="Fluent" Style="{DynamicResource SegButton}" Click="Theme_Click" />
                                    </UniformGrid>
                                </Border>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Reduce motion" Style="{DynamicResource FooterText}" />
                                        <TextBlock Text="Turns off all animations" Style="{DynamicResource BodyText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="ReduceMotionToggle" Grid.Column="1" Style="{DynamicResource ToggleBox}" VerticalAlignment="Center"
                                              Click="ReduceMotion_Click" ToolTip="On: no animations (instant, like v0.8.1)" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Show in taskbar" Style="{DynamicResource FooterText}" />
                                        <TextBlock Text="Off: the app only lives in the tray" Style="{DynamicResource BodyText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="TaskbarToggle" Grid.Column="1" Style="{DynamicResource ToggleBox}" VerticalAlignment="Center"
                                              Click="Taskbar_Click" ToolTip="Show the window's button on the taskbar" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="F2 cycles presets" Style="{DynamicResource FooterText}" />
                                        <TextBlock Text="Quiet, Balanced, Performance" Style="{DynamicResource BodyText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="F2PresetsToggle" Grid.Column="1" Style="{DynamicResource ToggleBox}" VerticalAlignment="Center"
                                              Click="F2Presets_Click" ToolTip="F2 (media mode, no Fn) cycles Quiet / Balanced / Performance" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="F3 / F4 open the app" Style="{DynamicResource FooterText}" />
                                        <TextBlock Text="F3 compact, F4 full menu. Press again to hide. Works over borderless games" Style="{DynamicResource BodyText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="F3OpensToggle" Grid.Column="1" Style="{DynamicResource ToggleBox}" VerticalAlignment="Center"
                                              Click="F3Opens_Click" ToolTip="F3 (media mode, no Fn) opens / hides Alien Controls" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Auto preset" Style="{DynamicResource FooterText}" />
                                        <TextBlock Text="Battery when unplugged, your last preset when plugged back in" Style="{DynamicResource BodyText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="AutoPresetToggle" Grid.Column="1" Style="{DynamicResource ToggleBox}" VerticalAlignment="Center"
                                              Click="AutoPreset_Click" ToolTip="Unplug: Battery. Plug in: back to Quiet / Balanced / Performance (never G-Mode)" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Notifications" Style="{DynamicResource FooterText}" />
                                        <TextBlock Text="Top-right toast for F1, F2 and plug / unplug" Style="{DynamicResource BodyText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="ToastsToggle" Grid.Column="1" Style="{DynamicResource ToggleBox}" VerticalAlignment="Center"
                                              Click="Toasts_Click" ToolTip="Window and tray clicks never show one" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Notification sound" Style="{DynamicResource FooterText}" />
                                        <TextBlock Text="Soft tick with those events" Style="{DynamicResource BodyText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox x:Name="ToastSoundToggle" Grid.Column="1" Style="{DynamicResource ToggleBox}" VerticalAlignment="Center"
                                              Click="ToastSound_Click" ToolTip="Plays even with notifications off" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GKeyText" Text="G-key (F1) toggles G-Mode" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Style="{DynamicResource GhostButton}" Content="Detect key" Click="GKeyDetect_Click" />
                                </Grid>

                                <!-- v0.9.15: reset + about -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Reset settings" Style="{DynamicResource FooterText}" />
                                        <TextBlock Text="Back to defaults, then the app restarts" Style="{DynamicResource BodyText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{DynamicResource GhostButton}" Content="Reset" Click="ResetSettings_Click" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock x:Name="AboutText" Style="{DynamicResource BodyText}" Margin="0,16,0,0" TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- v0.9.0: in-window GPU dialog ("RTX in use", restart), styled per theme through PopupPanel. -->
            <Grid x:Name="GpuDialogLayer" Grid.RowSpan="4" Visibility="Collapsed" Background="#B8000000">
                <Border Style="{DynamicResource PopupPanel}" Margin="22,0" VerticalAlignment="Center" UseLayoutRounding="True"
                        TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled">
                    <StackPanel>
                        <TextBlock x:Name="GpuDlgTitle" Style="{DynamicResource PopupTitle}" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <TextBlock x:Name="GpuDlgBody" Style="{DynamicResource BodyText}" TextWrapping="Wrap" />
                        <TextBlock x:Name="GpuDlgListTitle" Style="{DynamicResource FooterText}" Margin="0,12,0,4" Visibility="Collapsed" />
                        <ItemsControl x:Name="GpuDlgList" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding StringFormat='•  {0}'}" Style="{DynamicResource BodyText}" Margin="0,1" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel x:Name="GpuDlgButtons" HorizontalAlignment="Right" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
