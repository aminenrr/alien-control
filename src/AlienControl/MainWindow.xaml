<ui:FluentWindow x:Class="AlienControl.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Alien Control"
                 Width="540" SizeToContent="Height" ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Alien Control  ·  m15 R7" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="14,6,14,8">

            <!-- Sensors -->
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="CPU" FontSize="10.5" Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="CpuTempText" Text="--" FontSize="19" FontWeight="SemiBold" />
                        <ProgressBar x:Name="CpuTempBar" Height="3" Maximum="100" Margin="0,6,0,0" Foreground="{StaticResource AccentGradient}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="GPU" FontSize="10.5" Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="GpuTempText" Text="--" FontSize="19" FontWeight="SemiBold" />
                        <ProgressBar x:Name="GpuTempBar" Height="3" Maximum="100" Margin="0,6,0,0" Foreground="{StaticResource AccentGradient}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="CPU FAN" FontSize="10.5" Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="CpuFanText" Text="--" FontSize="19" FontWeight="SemiBold" />
                        <ProgressBar x:Name="CpuFanBar" Height="3" Maximum="6000" Margin="0,6,0,0" Foreground="{StaticResource AccentGradient}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="GPU FAN" FontSize="10.5" Foreground="{StaticResource MutedText}" />
                        <TextBlock x:Name="GpuFanText" Text="--" FontSize="19" FontWeight="SemiBold" />
                        <ProgressBar x:Name="GpuFanBar" Height="3" Maximum="6000" Margin="0,6,0,0" Foreground="{StaticResource AccentGradient}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Performance mode -->
            <Grid Margin="4,0,4,4">
                <TextBlock Text="⚡  Performance Mode" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="PowerHint" Text="" Style="{StaticResource SectionHint}" />
            </Grid>
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <RadioButton x:Name="ModeQuiet" GroupName="Mode" Content="Quiet" Style="{StaticResource SegButton}" Click="Mode_Click" />
                <RadioButton x:Name="ModeBalanced" GroupName="Mode" Content="Balanced" Style="{StaticResource SegButton}" Click="Mode_Click" />
                <RadioButton x:Name="ModePerformance" GroupName="Mode" Content="Performance" Style="{StaticResource SegButton}" Click="Mode_Click" />
                <RadioButton x:Name="ModeGMode" GroupName="Mode" Content="G-Mode" Style="{StaticResource GModeButton}" Click="Mode_Click" />
            </UniformGrid>

            <!-- G-key -->
            <Grid Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GKeyText" Text="G-key (F1) toggles G-Mode" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource MutedText}" />
                <ui:ToggleSwitch x:Name="GKeyToggle" Grid.Column="1" Margin="0,0,8,0" Click="GKeyToggle_Click" />
                <ui:Button Grid.Column="2" Content="Detect key" Click="GKeyDetect_Click" />
            </Grid>

            <!-- CPU boost (AC) -->
            <Grid Margin="4,0,4,4">
                <TextBlock Text="🧠  CPU Boost" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Plugged in" Style="{StaticResource SectionHint}" />
            </Grid>
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <RadioButton GroupName="Cpu" Tag="0" Content="Off" Padding="4,9" Style="{StaticResource SegButton}" Click="Cpu_Click" />
                <RadioButton GroupName="Cpu" Tag="1" Content="On" Padding="4,9" Style="{StaticResource SegButton}" Click="Cpu_Click" />
                <RadioButton GroupName="Cpu" Tag="3" Content="Efficient" Padding="4,9" Style="{StaticResource SegButton}" Click="Cpu_Click" />
                <RadioButton GroupName="Cpu" Tag="2" Content="Aggressive" Padding="4,9" Style="{StaticResource SegButton}" Click="Cpu_Click" />
            </UniformGrid>

            <!-- Fans -->
            <Grid Margin="4,0,4,4">
                <TextBlock Text="🌀  Fans" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="FanHint" Text="BIOS controlled" Style="{StaticResource SectionHint}" />
            </Grid>
            <UniformGrid Columns="3" Margin="0,0,0,10">
                <RadioButton x:Name="FanAuto" GroupName="Fan" Content="Auto" Padding="4,9" IsChecked="True" Style="{StaticResource SegButton}" Click="Fan_Click" />
                <RadioButton x:Name="FanMax" GroupName="Fan" Content="Max Boost" Padding="4,9" Style="{StaticResource SegButton}" Click="Fan_Click" />
                <RadioButton x:Name="FanCurve" GroupName="Fan" Content="Custom curve…" Padding="4,9" IsEnabled="False" Style="{StaticResource SegButton}" ToolTip="Coming later" />
            </UniformGrid>

            <!-- Lighting -->
            <Grid Margin="4,0,4,4">
                <TextBlock Text="💡  Lighting" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="BrightnessHint" Text="Brightness 80%" Style="{StaticResource SectionHint}" />
            </Grid>
            <Grid Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Swatch}" Background="#00E5FF" Tag="0,229,255" Click="Color_Click" ToolTip="Cyan" />
                    <Button Style="{StaticResource Swatch}" Background="#7C4DFF" Tag="124,77,255" Click="Color_Click" ToolTip="Purple" />
                    <Button Style="{StaticResource Swatch}" Background="#FF4D6A" Tag="255,77,106" Click="Color_Click" ToolTip="Red" />
                    <Button Style="{StaticResource Swatch}" Background="#3CFF7A" Tag="60,255,122" Click="Color_Click" ToolTip="Green" />
                    <Button Style="{StaticResource Swatch}" Background="#FFFFFF" Tag="255,255,255" Click="Color_Click" ToolTip="White" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="Breathe" Margin="6,0,0,0" Click="Breathe_Click" />
                    <ui:Button Content="Wave" Margin="6,0" Click="Wave_Click" />
                </StackPanel>
                <ui:Button Grid.Column="2" Content="Off" Click="LightsOff_Click" />
            </Grid>
            <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="80" Margin="4,10,4,0"
                    IsMoveToPointEnabled="True" PreviewMouseUp="Brightness_Commit" ValueChanged="Brightness_Changed" />

            <TextBlock x:Name="StatusText" Margin="4,8,4,0" FontSize="11.5" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ToggleSwitch x:Name="StartupToggle" Click="Startup_Click" />
                    <TextBlock Text="Run on startup" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#C9D2DC" FontSize="12" />
                </StackPanel>
                <TextBlock x:Name="VersionText" Text="v0.3" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedText}" FontSize="12" />
                <ui:Button Content="Quit" HorizontalAlignment="Right" Click="Quit_Click" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
