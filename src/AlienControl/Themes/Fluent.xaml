            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="HoverFx" CornerRadius="3" Background="{DynamicResource HoverFxBrush}" Opacity="0" IsHitTestVisible="False" />
                        <Border Background="Transparent" Padding="2,3">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#CCFFFFFF" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToggleBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" Width="40" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="#99FFFFFF" Background="Transparent">
                        <Ellipse x:Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" Fill="#CCFFFFFF" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="Black" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== lighting ===== -->
    <Style x:Key="LightPanel" TargetType="Border" />
    <Style x:Key="Swatch" TargetType="RadioButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="fx:Motion.Interactive" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="2" Visibility="Hidden" />
                        <Ellipse Width="22" Height="22" Fill="{TemplateBinding Background}" Stroke="#26FFFFFF" StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ValueSmall" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="#9EFFFFFF" />
    </Style>

    <Style x:Key="FxComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FxComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="#0FFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1,1,1,1" CornerRadius="5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FxCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FxComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource FxComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <DockPanel Margin="11,0,11,0" IsHitTestVisible="False">
                            <Path DockPanel.Dock="Right" Data="M2.5,4.5 L6,8 L9.5,4.5" Width="12" Height="12" Stroke="White"
                                  StrokeThickness="1.3" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Str.FxPrefix}" FontFamily="{StaticResource UiFont}" FontSize="12.5"
                                       Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="#2C2C30" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="7" Padding="3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="4" CornerRadius="2.0" Background="{DynamicResource AccentBrush}" /></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="4" CornerRadius="2.0" Background="#66FFFFFF" /></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LightSlider" TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge" /></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Width="20" Height="20">
                                            <Ellipse Fill="#454545" Stroke="#14FFFFFF" StrokeThickness="1" />
                                            <Ellipse Width="12" Height="12" Fill="{DynamicResource AccentBrush}" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== footer + popups ===== -->
    <Style x:Key="FooterBar" TargetType="Border">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderBrush" Value="#0DFFFFFF" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Background" Value="#1F000000" />
        <Setter Property="CornerRadius" Value="0,0,8,8" />
    </Style>
    <Style x:Key="FooterText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="VersionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="#80FFFFFF" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#9EFFFFFF" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PopupPanel" TargetType="Border">
        <Setter Property="Background" Value="#2A2A2E" />
        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style x:Key="PopupTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}" />
    <!-- 1.3.1-beta.2 Lights menu: laptop button, tiles lit = light ON (ZoneTile, a CheckBox), the All off / All on
         action tile (ZoneAction, a Button), and the zone icons. Theme-neutral: colors come from the theme brushes,
         so the block is the same in Legend and Fluent. -->
    <Viewbox x:Key="Icon.Ring" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24">
        <Path Data="M4 6h16v8h-16z" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.3" StrokeLineJoin="Round" Opacity="0.4" />
        <Path Data="M4.5 15.5h15a2.5 2.5 0 0 1 2.5 2.5a2.5 2.5 0 0 1 -2.5 2.5h-15a2.5 2.5 0 0 1 -2.5 -2.5a2.5 2.5 0 0 1 2.5 -2.5z M5.5 18h13" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Canvas></Viewbox>
    <Viewbox x:Key="Icon.Alien" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24">
        <Rectangle Canvas.Left="4.4" Canvas.Top="1" Width="15.2" Height="22" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Assets/logo.png" Stretch="Uniform" /></Rectangle.OpacityMask>
        </Rectangle>
    </Canvas></Viewbox>
    <Viewbox x:Key="Icon.Laptop" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 19l18 0 M5 7a1 1 0 0 1 1 -1h12a1 1 0 0 1 1 1v8a1 1 0 0 1 -1 1h-12a1 1 0 0 1 -1 -1l0 -8" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Bulb" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 12h1m8 -9v1m8 8h1m-15.4 -6.4l.7 .7m12.1 -.7l-.7 .7 M9 16a5 5 0 1 1 6 0a3.5 3.5 0 0 0 -1 3a2 2 0 0 1 -4 0a3.5 3.5 0 0 0 -1 -3 M9.7 17l4.6 0" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.BulbOff" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 12h1m8 -9v1m8 8h1m-15.4 -6.4l.7 .7m12.1 -.7l-.7 .7 M11.089 7.083a5 5 0 0 1 5.826 5.84m-1.378 2.611a5.012 5.012 0 0 1 -.537 .466a3.5 3.5 0 0 0 -1 3a2 2 0 1 1 -4 0a3.5 3.5 0 0 0 -1 -3a5 5 0 0 1 -.528 -7.544 M9.7 17h4.6 M3 3l18 18" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Style x:Key="ZoneTile" TargetType="CheckBox">
        <Setter Property="Width" Value="76" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Glow" CornerRadius="6" Margin="6" Background="{DynamicResource AccentGlow}" Opacity="0">
                            <Border.Effect><BlurEffect Radius="14" /></Border.Effect>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="6" Background="#33000000" BorderBrush="#1FFFFFFF" BorderThickness="1" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="Ic" Content="{TemplateBinding Tag}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,8"
                                              TextElement.Foreground="{DynamicResource TextMuted}" Opacity="0.7" />
                            <ContentPresenter x:Name="Lb" HorizontalAlignment="Center" TextElement.Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#48FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFaint}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Ic" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Ic" Property="Opacity" Value="1" />
                            <Setter TargetName="Lb" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ZoneAction" TargetType="Button">
        <Setter Property="Width" Value="76" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="6" Background="#12FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding Tag}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <ContentPresenter HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#48FFFFFF" />
                            <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 1.3.0-beta.2 settings page: card around each tab's rows, rows split by a hairline -->
    <Style x:Key="SetCard" TargetType="Border">
        <Setter Property="Background" Value="#0BFFFFFF" />
        <Setter Property="BorderBrush" Value="#11FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style x:Key="SetRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="#12FFFFFF" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style x:Key="SetRowFirst" TargetType="Border" BasedOn="{StaticResource SetRow}"><Setter Property="BorderThickness" Value="0" /></Style>
</ResourceDictionary>
