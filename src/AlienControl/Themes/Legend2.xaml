<!-- Alien Controls 2.0 styles (hand written, merged after Legend.xaml by App.ApplyTheme).
     Matches docs/mockups/2.0 (made with the mockup script app2.py, kept in the project workspace, not in this repo):
     window 440 x 820, header 52, tabs 40, status 38, footer 52, cards #0E1013 on #090A0C, lines #1C2127 / #16191E,
     accent follows the lighting colour (MainWindow.ApplyAccent).
     Same rules as Legend.xaml: no looping animations, hover / press / selection are one-shot (fx:Motion.Interactive).
     2.0.0-beta1.4: the fixed palette lives here as brushes (build review #10, the hex values were repeated inline), the
     selected fills follow the lighting colour (AccentSelBg / AccentPillBg, Amine), keyboard focus shows a thin accent
     ring (FocusRing2, Amine), and ToolTip / TextBox / ScrollBar have their own Legend styles (WPF-UI is gone).
     A StaticResource here may only name a key of this file: Legend.xaml is a separate merged dictionary. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fx="clr-namespace:AlienControl"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== strings (WPF has no letter spacing: spaced capitals, like Legend.xaml) ===== -->
    <sys:String x:Key="Str2.Home">H O M E</sys:String>
    <sys:String x:Key="Str2.Tuning">T U N I N G</sys:String>
    <sys:String x:Key="Str2.Lights">L I G H T S</sys:String>
    <sys:String x:Key="Str2.Overlay">O V E R L A Y</sys:String>
    <sys:String x:Key="Str2.Preset">P R E S E T</sys:String>
    <sys:String x:Key="Str2.GMode">G - M O D E</sys:String>
    <sys:String x:Key="Str2.Lighting">L I G H T I N G</sys:String>
    <sys:String x:Key="Str2.Perf">P E R F O R M A N C E   M O D E</sys:String>
    <sys:String x:Key="Str2.GpuMode">G P U   M O D E</sys:String>
    <sys:String x:Key="Str2.GpuOc">G P U   O V E R C L O C K</sys:String>
    <sys:String x:Key="Str2.CpuBoost">C P U   B O O S T</sys:String>
    <sys:String x:Key="Str2.Refresh">R E F R E S H</sys:String>
    <sys:String x:Key="Str2.Fans">F A N S</sys:String>
    <sys:String x:Key="Str2.Zones">Z O N E S</sys:String>
    <sys:String x:Key="Str2.Color">C O L O R</sys:String>
    <sys:String x:Key="Str2.Fx">E F F E C T   A N D   B R I G H T N E S S</sys:String>
    <sys:String x:Key="Str2.Timeout">B A C K L I G H T   T I M E O U T</sys:String>
    <sys:String x:Key="Str2.StatusKeys">S T A T U S   K E Y S</sys:String>
    <sys:String x:Key="Str2.OverlayLevel">O V E R L A Y   L E V E L</sys:String>
    <sys:String x:Key="Str2.Advanced">A D V A N C E D</sys:String>
    <sys:String x:Key="Str2.General">G E N E R A L</sys:String>
    <sys:String x:Key="Str2.Keys">K E Y S</sys:String>
    <sys:String x:Key="Str2.Alerts">A L E R T S</sys:String>
    <sys:String x:Key="Str2.TabGeneralKeys">G E N E R A L  ·  K E Y S</sys:String>
    <sys:String x:Key="Str2.TabAlertsAdvanced">A L E R T S  ·  A D V A N C E D</sys:String>

    <!-- ===== palette (HANDOFF.md colours) ===== -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F6F9" />
    <SolidColorBrush x:Key="TextBody" Color="#A9B4BF" />
    <SolidColorBrush x:Key="TextMuted" Color="#6E7A86" />
    <!-- 2.0.0-beta1.4 (build review #12): hint text (section hints 10 DIP, row subtitles 10.5 DIP) is #76828E, 4.86:1 on
         the card (#6E7A86 was 4.35:1, under WCAG AA's 4.5:1) -->
    <SolidColorBrush x:Key="TextFaint" Color="#76828E" />
    <SolidColorBrush x:Key="TextDisabled" Color="#4A535C" />
    <SolidColorBrush x:Key="Line2" Color="#1C2127" />
    <SolidColorBrush x:Key="LineSoft" Color="#16191E" />
    <SolidColorBrush x:Key="Tick2" Color="#2A3138" />
    <SolidColorBrush x:Key="Card2Brush" Color="#0E1013" />
    <SolidColorBrush x:Key="Track2Brush" Color="#0B0D10" />
    <SolidColorBrush x:Key="Amber2" Color="#FFB020" />
    <!-- 2.0.0-beta1.4 (Amine): selected fills, the default cyan here; MainWindow.ApplyAccent replaces both with a dark
         blend of the lighting colour (about 16% over the card for tiles, toggles and buttons, 22% for pill items) -->
    <SolidColorBrush x:Key="AccentSelBg" Color="#0C3239" />
    <SolidColorBrush x:Key="AccentPillBg" Color="#093D45" />
    <!-- rainbow swatch (custom colour), as in the mockup: warm top, cool bottom. 2.0.0-beta1.4: the red is the Red
         swatch's #FF4D6A (one red, build review #10) -->
    <LinearGradientBrush x:Key="CustomSwatchBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4D6A" Offset="0" />
        <GradientStop Color="#7C4DFF" Offset="0.45" />
        <GradientStop Color="#FFB020" Offset="0.55" />
        <GradientStop Color="#00E5FF" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== 2.0 icons (Tabler, MIT) ===== -->
    <Viewbox x:Key="Icon.Adjust" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M4 10a2 2 0 1 0 4 0a2 2 0 0 0 -4 0 M6 4v4 M6 12v8 M10 16a2 2 0 1 0 4 0a2 2 0 0 0 -4 0 M12 4v10 M12 18v2 M16 7a2 2 0 1 0 4 0a2 2 0 0 0 -4 0 M18 4v1 M18 9v11" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.ChartBar" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 13a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -6 M15 9a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -10 M9 5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v14a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1l0 -14 M4 20h14" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Palette" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M12 21a9 9 0 0 1 0 -18c4.97 0 9 3.582 9 8c0 1.06 -.474 2.078 -1.318 2.828c-.844 .75 -1.989 1.172 -3.182 1.172h-2.5a2 2 0 0 0 -1 3.75a1.3 1.3 0 0 1 -1 2.25 M7.5 10.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M11.5 7.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M15.5 10.5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Sparkles" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M16 18a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2m0 -12a2 2 0 0 1 2 2a2 2 0 0 1 2 -2a2 2 0 0 1 -2 -2a2 2 0 0 1 -2 2m-7 12a6 6 0 0 1 6 -6a6 6 0 0 1 -6 -6a6 6 0 0 1 -6 6a6 6 0 0 1 6 6" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Clock" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0 M12 7v5l3 3" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.AdjustH" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M12 6a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M4 6l8 0 M16 6l4 0 M6 12a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M4 12l2 0 M10 12l10 0 M15 18a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M4 18l11 0 M19 18l1 0" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Lock" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6 M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0 M8 11v-4a4 4 0 1 1 8 0v4" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Gamepad" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M2 8a2 2 0 0 1 2 -2h16a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-16a2 2 0 0 1 -2 -2l0 -8 M6 12h4m-2 -2v4 M15 11l0 .01 M18 13l0 .01" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>

    <!-- ===== 2.0.0-beta1.4 (Amine): keyboard focus ===== -->
    <!-- A thin (2 px) accent outline 3 px outside the control, rounded. WPF draws a FocusVisualStyle only for keyboard
         focus (Tab, arrows), never after a mouse click, so the mouse look is unchanged. -->
    <Style x:Key="FocusRing2">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="6" RadiusY="6" StrokeThickness="2" Stroke="{DynamicResource AccentBrush}"
                               SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- the same ring for every control without its own FocusVisualStyle (sliders, the FX box) -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" BasedOn="{StaticResource FocusRing2}" />

    <!-- ===== 2.0.0-beta1.4: controls WPF-UI used to style (mockups/2.0-beta1.4/5-controls.png) ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Card2Brush}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="4"
                            Padding="10,6" SnapsToDevicePixels="True">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Card2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="7,0" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Tick2}" /></Trigger>
                        <!-- accent border while focused (mouse or keyboard), the box's own focus look -->
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- scrollbar: thin accent thumb, no track, no arrows -->
    <Style x:Key="ScrollPage2" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb2" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource AccentBrush}" CornerRadius="2" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Width="4" HorizontalAlignment="Center">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage2}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage2}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb2}" MinHeight="24" /></Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Height="4" VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage2}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage2}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb2}" MinWidth="24" /></Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Viewbox x:Key="Icon.Gauge" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M13.41 10.59l2.59 -2.59 M7 12a5 5 0 0 1 5 -5" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Check" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M5 12l5 5l10 -10" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>

    <!-- ===== shell ===== -->
    <Style x:Key="Header2" TargetType="Border">
        <Setter Property="Padding" Value="18,0,10,0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="Brand2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Chip2" TargetType="Border">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="Padding" Value="7,1,7,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentSelBg}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ChipText2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- tab: caps text, cyan underline + soft glow on the active one -->
    <Style x:Key="Tab2" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" TextElement.Foreground="{TemplateBinding Foreground}" />
                        <Border x:Name="Glow" Width="60" Height="8" CornerRadius="4" VerticalAlignment="Bottom" Margin="0,0,0,-2" Background="{DynamicResource AccentBrush}" Opacity="0.15" Visibility="Hidden" />
                        <Border x:Name="Ul" Width="52" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,1" Background="{DynamicResource AccentBrush}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBody}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter TargetName="Ul" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== section header: icon, spaced caps title, hairline, hint (24 px with the gap below) ===== -->
    <Style x:Key="Sec2" TargetType="Grid">
        <Setter Property="Height" Value="17" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style x:Key="SecIcon2" TargetType="ContentControl">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style x:Key="SecTitle2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="SecLine2" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Line2}" />
    </Style>
    <Style x:Key="SecHint2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="Badge2" TargetType="Border">
        <Setter Property="Padding" Value="6,1,6,1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Amber2}" />
        <Setter Property="Background" Value="#22FFB020" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeText2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Amber2}" />
    </Style>

    <!-- ===== cards ===== -->
    <Style x:Key="Card2" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style x:Key="CellLabel2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>
    <!-- 2.0.0-beta1.4 (Amine, mockup 6-gpu-source.png): the INTEL / NVIDIA chip next to the GPU tile labels. Accent text
         and 1 px accent border on the dark accent tint (both follow the lighting colour), mono semibold, 3 px corners.
         Collapsed until the GPU mode is known (MainWindow.UpdateGpuSourceTags). -->
    <Style x:Key="GpuSourceChip2" TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Padding" Value="3,0,3,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentPillBg}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="GpuSourceChipText2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.Capitals" Value="SmallCaps" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="LineHeight" Value="11" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <Style x:Key="CellValue2" TargetType="Run">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style x:Key="CellUnit2" TargetType="Run">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>
    <Style x:Key="Strip2" TargetType="Border">
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="{StaticResource Card2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="11,0" />
    </Style>
    <Style x:Key="StripLabel2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StripValue2" TargetType="Run">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style x:Key="StripAccent2" TargetType="Run" BasedOn="{StaticResource StripValue2}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ===== tiles: icon + label, tinted by BorderBrush (accent by default, preset colour on Home) ===== -->
    <Style x:Key="Tile2" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextBody}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="2.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing2}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="fx:Motion.Interactive" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource Card2Brush}" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="5" />
                        <!-- 2.0.0-beta1.4 (Amine): the selected fill is a dark tint of the tile's own colour (BorderBrush: the
                             lighting colour by default, the preset colour on Home, white on G-Mode = grey), was #0A1A1F -->
                        <Border x:Name="Tint" Margin="1" CornerRadius="4" Background="{TemplateBinding BorderBrush}" Opacity="0.16" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="HoverFx" Margin="1" CornerRadius="4" Background="{DynamicResource HoverFxBrush}" Opacity="0" IsHitTestVisible="False" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,2,0">
                            <ContentPresenter x:Name="Ic" Content="{TemplateBinding Tag}" Width="19" Height="19" Margin="0,0,0,6" HorizontalAlignment="Center"
                                              TextElement.Foreground="{StaticResource TextBody}" />
                            <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <Grid VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28*" /><ColumnDefinition Width="44*" /><ColumnDefinition Width="28*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Glow" Grid.Column="1" Height="6" Margin="-2,0,-2,1" CornerRadius="3" Background="{TemplateBinding BorderBrush}" Opacity="0.18" Visibility="Collapsed" />
                            <Border x:Name="Ul" Grid.Column="1" Height="2" Margin="0,0,0,3" CornerRadius="1" Background="{TemplateBinding BorderBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Tint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ic" Property="TextElement.Foreground" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ul" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ic" Property="Opacity" Value="0.35" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- text-only segment (CPU boost, refresh, fans): same look without the icon -->
    <Style x:Key="Seg2" TargetType="RadioButton" BasedOn="{StaticResource Tile2}">
        <Setter Property="Tag" Value="{x:Null}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style x:Key="Lock2" TargetType="ContentControl">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,8,9,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- ===== small segmented pill (G-MODE / + PERF, timeout, toast style, chime pack) ===== -->
    <Style x:Key="PillTrack2" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Track2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style x:Key="PillItem2" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="3" Background="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBody}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPillBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 2.0.0-beta1.2: same look as PillItem2, but each item switches on and off on its own (GPU OC G-MODE / + PERF) -->
    <Style x:Key="PillToggle2" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="3" Background="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBody}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPillBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 2.0.0-beta1.2: thin vertical divider between the items of a strip -->
    <Style x:Key="StripDivider2" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Background" Value="{StaticResource Line2}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- body-font variant (Pill / Classic, Soft / Classic in Settings) -->
    <Style x:Key="PillItemText2" TargetType="RadioButton" BasedOn="{StaticResource PillItem2}">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- ===== toggle (36 x 18, square knob) ===== -->
    <Style x:Key="Toggle2" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing2}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" Width="36" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Tick2}" Background="{StaticResource Track2Brush}">
                        <Border x:Name="Knob" Width="11" Height="11" CornerRadius="2" Margin="3,0" HorizontalAlignment="Left" Background="{StaticResource TextDisabled}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelBg}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== buttons ===== -->
    <Style x:Key="Button2" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="#101318" />
        <Setter Property="BorderBrush" Value="{StaticResource Line2}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing2}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="fx:Motion.Interactive" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" />
                        <Border x:Name="HoverFx" Margin="1" CornerRadius="4" Background="{DynamicResource HoverFxBrush}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ButtonPrimary2" TargetType="Button" BasedOn="{StaticResource Button2}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentSelBg}" />
    </Style>
    <Style x:Key="HeaderButton2" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource TextBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing2}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="fx:Motion.Interactive" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="Transparent" CornerRadius="4" />
                        <Border x:Name="HoverFx" Background="{DynamicResource HoverFxBrush}" CornerRadius="4" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextPrimary}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== swatch (size set where it's used) ===== -->
    <Style x:Key="Swatch2" TargetType="RadioButton">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing2}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="fx:Motion.Interactive" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" />
                        <Border x:Name="Ring" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Line2}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="#FFFFFF" />
                            <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== settings rows ===== -->
    <Style x:Key="RowTitle2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RowSub2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RowLine2" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource LineSoft}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style x:Key="RowFirst2" TargetType="Border" BasedOn="{StaticResource RowLine2}">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="Status2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Version2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
