<!-- Legend theme for Alien Controls (icons, accent defaults and the 1.x styles 2.0 still uses). Generated by
     dev/gen_themes.py up to 2.0.0-beta1.3; since 2.0.0-beta1.4 it is edited by hand like Legend2.xaml (the generator needed
     icon files that were never in the repo, see docs/DEVELOPMENT.md). The unused 1.x keys were removed in beta1.4.
     No animations in XAML:
     v0.8.2 hover fades (HoverFx overlays), press / selection scales are short one-shot storyboards run by Motion.cs
     (fx:Motion.Interactive), Opacity + RenderTransform only, skipped when Reduce motion is on. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fx="clr-namespace:AlienControl"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <sys:String x:Key="Str.Title">A L I E N   C O N T R O L S</sys:String>
    <sys:String x:Key="Str.Cpu">C P U</sys:String>
    <sys:String x:Key="Str.CpuFan">C P U   F A N</sys:String>
    <sys:String x:Key="Str.Gpu">G P U</sys:String>
    <sys:String x:Key="Str.GpuFan">G P U   F A N</sys:String>
    <sys:String x:Key="Str.Ram">R A M</sys:String>
    <sys:String x:Key="Str.Vram">V R A M</sys:String>
    <sys:String x:Key="Str.CpuUse">C P U   U S E</sys:String>
    <sys:String x:Key="Str.GpuUse">G P U   U S E</sys:String>
    <sys:String x:Key="Str.Clean">CLICK TO CLEAN</sys:String>
    <sys:String x:Key="Str.FxPrefix">FX</sys:String>
    <sys:String x:Key="Str.Settings">S E T T I N G S</sys:String>
    <sys:String x:Key="Str.OcKeep">KEEP THESE CLOCKS?</sys:String>

    <!-- 2.0.0-beta1.4: TextPrimary / TextBody / TextMuted moved to Legend2.xaml with the rest of the palette -->

    <!-- default accent (MainWindow.ApplyAccent overrides these at app level) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#00E5FF" />
    <SolidColorBrush x:Key="OcWarnBrush" Color="#FFB020" />
    <SolidColorBrush x:Key="AccentBorder" Color="#8000D8F0" />
    <SolidColorBrush x:Key="AccentFaint" Color="#2E00E5FF" />
    <SolidColorBrush x:Key="AccentGlow" Color="#5500E5FF" />
    <!-- v0.8.6: hover overlay, ~10% white (the old #14191E on #0E1013 was ~3 RGB steps, invisible) -->
    <SolidColorBrush x:Key="HoverFxBrush" Color="#1AFFFFFF" />
    <LinearGradientBrush x:Key="AccentCheckedBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1700E5FF" Offset="0" /><GradientStop Color="#0500E5FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TopLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0000E5FF" Offset="0" /><GradientStop Color="#00E5FF" Offset="0.18" />
        <GradientStop Color="#00E5FF" Offset="0.5" /><GradientStop Color="#7C4DFF" Offset="0.82" /><GradientStop Color="#007C4DFF" Offset="1" />
    </LinearGradientBrush>

    <!-- tick bars: 6 px on, 2 px off -->
    <DrawingBrush x:Key="TickMask" TileMode="Tile" Viewport="0,0,8,4" ViewportUnits="Absolute" Viewbox="0,0,8,4" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#01000000" Geometry="M0,0 H8 V4 H0 Z" />
                <GeometryDrawing Brush="Black" Geometry="M0,0 H6 V4 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="HexPattern" TileMode="Tile" Viewport="0,0,28,24" ViewportUnits="Absolute" Viewbox="0,0,28,24" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M7,0 L21,0 L28,12 L21,24 L7,24 L0,12 Z">
                <GeometryDrawing.Pen><Pen Brush="#0F00E5FF" Thickness="1" /></GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Tabler Icons (MIT, tabler.io): outline, 24 viewBox, stroke 2, round caps/joins -->
    <Viewbox x:Key="Icon.Activity" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 12h4l3 8l4 -16l3 8h4" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Battery" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M4 9a2 2 0 0 1 2 -2h11a2 2 0 0 1 2 2v.5a.5 .5 0 0 0 .5 .5a.5 .5 0 0 1 .5 .5v3a.5 .5 0 0 1 -.5 .5a.5 .5 0 0 0 -.5 .5v.5a2 2 0 0 1 -2 2h-5.5 M3 16.143c0 -2.84 2.09 -5.143 4.667 -5.143h2.333v.857c0 2.84 -2.09 5.143 -4.667 5.143h-2.333v-.857 M3 20v-3" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Quiet" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454l0 .008" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Balanced" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M7 20l10 0 M6 6l6 -1l6 1 M12 3l0 17 M9 12l-3 -6l-3 6a3 3 0 0 0 6 0 M21 12l-3 -6l-3 6a3 3 0 0 0 6 0" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Performance" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M13.41 10.59l2.59 -2.59 M7 12a5 5 0 0 1 5 -5" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.GMode" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M12 10.941c2.333 -3.308 .167 -7.823 -1 -8.941c0 3.395 -2.235 5.299 -3.667 6.706c-1.43 1.408 -2.333 3.294 -2.333 5.588c0 3.704 3.134 6.706 7 6.706c3.866 0 7 -3.002 7 -6.706c0 -1.712 -1.232 -4.403 -2.333 -5.588c-2.084 3.353 -3.257 3.353 -4.667 2.235" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.IGpu" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M5 21c.5 -4.5 2.5 -8 7 -10 M9 18c6.218 0 10.5 -3.288 11 -12v-2h-4.014c-9 0 -11.986 4 -12 9c0 1 0 3 2 5h3l.014 0" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Optimus" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M7 10h14l-4 -4 M17 14h-14l4 4" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Ultimate" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M13 3l0 7l6 0l-8 11l0 -7l-6 0l8 -11" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Cpu" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M5 6a1 1 0 0 1 1 -1h12a1 1 0 0 1 1 1v12a1 1 0 0 1 -1 1h-12a1 1 0 0 1 -1 -1l0 -12 M9 9h6v6h-6l0 -6 M3 10h2 M3 14h2 M10 3v2 M14 3v2 M21 10h-2 M21 14h-2 M14 21v-2 M10 21v-2" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Fan" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M9 13a3 3 0 1 0 6 0a3 3 0 1 0 -6 0 M14.167 10.5c.722 -1.538 1.156 -3.043 1.303 -4.514c.22 -1.63 -.762 -2.986 -3.47 -2.986s-3.69 1.357 -3.47 2.986c.147 1.471 .581 2.976 1.303 4.514 M13.169 16.751c.97 1.395 2.057 2.523 3.257 3.386c1.3 1 2.967 .833 4.321 -1.512c1.354 -2.345 .67 -3.874 -.85 -4.498c-1.348 -.608 -2.868 -.985 -4.562 -1.128 M8.664 13c-1.693 .143 -3.213 .52 -4.56 1.128c-1.522 .623 -2.206 2.153 -.852 4.498s3.02 2.517 4.321 1.512c1.2 -.863 2.287 -1.991 3.258 -3.386" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Light" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 12h1m8 -9v1m8 8h1m-15.4 -6.4l.7 .7m12.1 -.7l-.7 .7 M9 16a5 5 0 1 1 6 0a3.5 3.5 0 0 0 -1 3a2 2 0 0 1 -4 0a3.5 3.5 0 0 0 -1 -3 M9.7 17l4.6 0" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Clean" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M19 20h-10.5l-4.21 -4.3a1 1 0 0 1 0 -1.41l10 -10a1 1 0 0 1 1.41 0l5 5a1 1 0 0 1 0 1.41l-9.2 9.3 M18 13.3l-6.3 -6.3" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Power" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M7 6a7.75 7.75 0 1 0 10 0 M12 4l0 8" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Minimize" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M5 12l14 0" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Close" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M18 6l-12 12 M6 6l12 12" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Settings" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065 M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Display" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1v-10 M7 20h10 M9 16v4 M15 16v4" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Plug" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M9.785 6l8.215 8.215l-2.054 2.054a5.81 5.81 0 1 1 -8.215 -8.215l2.054 -2.054 M4 20l3.5 -3.5 M15 4l-3.5 3.5 M20 9l-3.5 3.5" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Keys" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M2 8a2 2 0 0 1 2 -2h16a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-16a2 2 0 0 1 -2 -2l0 -8 M6 10l0 .01 M10 10l0 .01 M14 10l0 .01 M18 10l0 .01 M6 14l0 .01 M18 14l0 .01 M10 14l4 .01" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Alerts" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6 M9 17v1a3 3 0 0 0 6 0v-1" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Code" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M7 8l-4 4l4 4 M17 8l4 4l-4 4 M14 4l-4 16" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Back" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M5 12l14 0 M5 12l6 6 M5 12l6 -6" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.Play" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M7 4v16l13 -8z" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>

    <!-- ===== window ===== -->
    <Style x:Key="WindowCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#1D2228" />
        <Setter Property="Background" Value="#090A0C" />
    </Style>
    <Style x:Key="HeaderPattern" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HexPattern}" />
        <Setter Property="CornerRadius" Value="10,10,0,0" />
    </Style>

    <!-- ===== stats ===== -->
    <Style x:Key="StatBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Margin" Value="0,7,0,0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="#1C2127" OpacityMask="{StaticResource TickMask}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                OpacityMask="{StaticResource TickMask}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== sections ===== -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#E9EEF2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== lighting ===== -->
    <Style x:Key="FxComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#E6EDF3" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A2026" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FxComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="#090A0C" BorderBrush="#232930" BorderThickness="1,1,1,1" CornerRadius="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FxCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing2}" />
        <Setter Property="Foreground" Value="#E6EDF3" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FxComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource FxComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <DockPanel Margin="9,0,9,0" IsHitTestVisible="False">
                            <Path DockPanel.Dock="Right" Data="M2.5,4.5 L6,8 L9.5,4.5" Width="12" Height="12" Stroke="#E6EDF3"
                                  StrokeThickness="1.3" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Str.FxPrefix}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="#6E7A86" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="#0E1013" BorderBrush="#232930" BorderThickness="1" CornerRadius="4" Padding="3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="2" CornerRadius="1.0" Background="{DynamicResource AccentBrush}" /></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="2" CornerRadius="1.0" Background="#232930" /></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LightSlider" TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge" /></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Width="10" Height="14" CornerRadius="2" Background="#E6EDF3" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== footer + popups ===== -->
    <Style x:Key="FooterText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="#A9B4BF" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#6E7A86" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PopupPanel" TargetType="Border">
        <Setter Property="Background" Value="#0E1013" />
        <Setter Property="BorderBrush" Value="#232930" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="PopupTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}" />
    <!-- 1.3.1-beta.2 Lights menu (2.0: inline on the Lights tab): tiles lit = light ON (ZoneTile, a CheckBox), the Turn off / Turn on
         action tile (ZoneAction, a Button), and the zone icons. Colours come from the theme brushes. -->
    <Viewbox x:Key="Icon.Ring" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24">
        <Path Data="M4 6h16v8h-16z" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.3" StrokeLineJoin="Round" Opacity="0.4" />
        <Path Data="M4.5 15.5h15a2.5 2.5 0 0 1 2.5 2.5a2.5 2.5 0 0 1 -2.5 2.5h-15a2.5 2.5 0 0 1 -2.5 -2.5a2.5 2.5 0 0 1 2.5 -2.5z M5.5 18h13" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Canvas></Viewbox>
    <Viewbox x:Key="Icon.Alien" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24">
        <Rectangle Canvas.Left="4.4" Canvas.Top="1" Width="15.2" Height="22" Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}">
            <Rectangle.OpacityMask><ImageBrush ImageSource="pack://application:,,,/Assets/logo.png" Stretch="Uniform" /></Rectangle.OpacityMask>
        </Rectangle>
    </Canvas></Viewbox>
    <Viewbox x:Key="Icon.Bulb" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 12h1m8 -9v1m8 8h1m-15.4 -6.4l.7 .7m12.1 -.7l-.7 .7 M9 16a5 5 0 1 1 6 0a3.5 3.5 0 0 0 -1 3a2 2 0 0 1 -4 0a3.5 3.5 0 0 0 -1 -3 M9.7 17l4.6 0" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Viewbox x:Key="Icon.BulbOff" x:Shared="False" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Data="M3 12h1m8 -9v1m8 8h1m-15.4 -6.4l.7 .7m12.1 -.7l-.7 .7 M11.089 7.083a5 5 0 0 1 5.826 5.84m-1.378 2.611a5.012 5.012 0 0 1 -.537 .466a3.5 3.5 0 0 0 -1 3a2 2 0 1 1 -4 0a3.5 3.5 0 0 0 -1 -3a5 5 0 0 1 -.528 -7.544 M9.7 17h4.6 M3 3l18 18" Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
    <Style x:Key="ZoneTile" TargetType="CheckBox">
        <Setter Property="Width" Value="76" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing2}" />   <!-- 2.0.0-beta1.4 (Amine): keyboard focus ring -->
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Glow" CornerRadius="6" Margin="6" Background="{DynamicResource AccentGlow}" Opacity="0">
                            <Border.Effect><BlurEffect Radius="14" /></Border.Effect>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="6" Background="#33000000" BorderBrush="#1FFFFFFF" BorderThickness="1" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="Ic" Content="{TemplateBinding Tag}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,8"
                                              TextElement.Foreground="{DynamicResource TextMuted}" Opacity="0.7" />
                            <ContentPresenter x:Name="Lb" HorizontalAlignment="Center" TextElement.Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#48FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <!-- 2.0.0-beta1.4 (Amine): a solid dark tint of the lighting colour (was AccentFaint, see-through teal) -->
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSelBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Ic" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Ic" Property="Opacity" Value="1" />
                            <Setter TargetName="Lb" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ZoneAction" TargetType="Button">
        <Setter Property="Width" Value="76" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing2}" />   <!-- 2.0.0-beta1.4 (Amine): keyboard focus ring -->
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="#12FFFFFF" />
        <Setter Property="BorderBrush" Value="#24FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                        <Border x:Name="Hv" CornerRadius="6" Background="#10FFFFFF" Opacity="0" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding Tag}" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <ContentPresenter HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hv" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
