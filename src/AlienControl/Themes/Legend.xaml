    <!-- ===== window ===== -->
    <Style x:Key="WindowCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#1D2228" />
        <Setter Property="Background" Value="#090A0C" />
    </Style>
    <Style x:Key="TopLine" TargetType="Border">
        <Setter Property="Height" Value="2" />
        <Setter Property="Margin" Value="6,0,6,0" />
        <Setter Property="Background" Value="{DynamicResource TopLineBrush}" />
    </Style>
    <Style x:Key="HeaderBar" TargetType="Border">
        <Setter Property="Padding" Value="14,10,8,10" />
        <Setter Property="BorderBrush" Value="#16191E" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F00E5FF" Offset="0" /><GradientStop Color="#0000E5FF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HeaderPattern" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HexPattern}" />
        <Setter Property="CornerRadius" Value="10,10,0,0" />
    </Style>
    <Style x:Key="LogoImage" TargetType="Image"><Setter Property="Height" Value="20" /></Style>
    <Style x:Key="BrandText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#D9E1E8" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ModelBadge" TargetType="Border">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ModelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- v0.8.1 current-profile chip: dot/text/border tint set in code from Profiles.Tint (read-only) -->
    <Style x:Key="ProfileChip" TargetType="Border">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="ProfileChipDot" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ProfileChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="#7F8B97" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="fx:Motion.Interactive" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" />
                        <Border x:Name="HoverFx" Background="#14FFFFFF" CornerRadius="3" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#E6EDF3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Thickness x:Key="BodyMargin">12,12,12,6</Thickness>

    <!-- ===== stats ===== -->
    <Style x:Key="StatsCard" TargetType="Border"><Setter Property="Background" Value="Transparent" /></Style>
    <Style x:Key="StatsGrid" TargetType="Border">
        <Setter Property="Background" Value="#1A1E24" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0.5" />
    </Style>
    <Style x:Key="StatCell" TargetType="Border">
        <Setter Property="Background" Value="#0E1013" />
        <Setter Property="Margin" Value="0.5" />
        <Setter Property="Padding" Value="9,8,9,9" />
    </Style>
    <Style x:Key="StatCellFirst" TargetType="Border" BasedOn="{StaticResource StatCell}" />
    <Style x:Key="MemRow" TargetType="Border" />
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="#6E7A86" />
    </Style>
    <Style x:Key="CleanText" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style x:Key="StatValueLine" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <Style x:Key="StatValue" TargetType="Run">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#F2F6F9" />
    </Style>
    <Style x:Key="StatUnit" TargetType="Run">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="#6E7A86" />
    </Style>
    <Style x:Key="StatBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Margin" Value="0,7,0,0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="#1C2127" OpacityMask="{StaticResource TickMask}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                OpacityMask="{StaticResource TickMask}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PwrRow" TargetType="Border">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="BorderBrush" Value="#1A1E24" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="#0C0E10" />
    </Style>
    <Style x:Key="PwrGrid" TargetType="Grid"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    <Style x:Key="PwrItem" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#6E7A86" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PwrValue" TargetType="Run">
        <Setter Property="Foreground" Value="#E6EDF3" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="PwrTotal" TargetType="Run">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===== sections ===== -->
    <Style x:Key="SectionPanel" TargetType="Border"><Setter Property="Margin" Value="0,14,0,0" /></Style>
    <Style x:Key="SectionPanelTop" TargetType="Border" BasedOn="{StaticResource SectionPanel}" />
    <Style x:Key="SectionPanelBottom" TargetType="Border" BasedOn="{StaticResource SectionPanel}" />
    <Style x:Key="SectionHeader" TargetType="Grid"><Setter Property="Margin" Value="0,0,0,7" /></Style>
    <!-- v0.8.4: section numbers (01-06) removed at Amine's request; the icon alone names the section, like Fluent. -->
    <Style x:Key="SectionNum" TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /></Style>
    <Style x:Key="SectionIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#E9EEF2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SectionLine" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#20262D" Offset="0" /><GradientStop Color="#0020262D" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SectionHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="#6E7A86" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Track" TargetType="Border"><Setter Property="Margin" Value="-2.5" /></Style>

    <!-- ===== buttons ===== -->
    <Style x:Key="SegButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#A9B4BF" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="2.5" />
        <Setter Property="Padding" Value="2,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="fx:Motion.Interactive" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="#0E1013" BorderBrush="#1C2127" BorderThickness="1" CornerRadius="4" />
                        <Border x:Name="HoverFx" Margin="1" CornerRadius="3" Background="#14191E" Opacity="0" IsHitTestVisible="False" />
                        <Border BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <StackPanel HorizontalAlignment="Center">
                                <ContentPresenter x:Name="Ic" Content="{TemplateBinding Tag}" Width="20" Height="20" Margin="0,0,0,6"
                                                  TextElement.Foreground="#7F8B97" />
                                <ContentPresenter HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Grid VerticalAlignment="Bottom" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22*" /><ColumnDefinition Width="56*" /><ColumnDefinition Width="22*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Glow" Grid.Column="1" Height="4" Margin="-3,0,-3,-2" CornerRadius="2" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource AccentGlow}" Visibility="Collapsed" />
                            <Border x:Name="Ul" Grid.Column="1" Height="2" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentCheckedBg}" />
                            <Setter TargetName="Ic" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Ul" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ModeButton" TargetType="RadioButton" BasedOn="{StaticResource SegButton}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="2,10,2,9" />
    </Style>
    <Style x:Key="GModeButton" TargetType="RadioButton" BasedOn="{StaticResource ModeButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="#0E1013" BorderBrush="#1C2127" BorderThickness="1" CornerRadius="4" />
                        <Border x:Name="HoverFx" Margin="1" CornerRadius="3" Background="#14191E" Opacity="0" IsHitTestVisible="False" />
                        <Border BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <StackPanel HorizontalAlignment="Center">
                                <ContentPresenter x:Name="Ic" Content="{TemplateBinding Tag}" Width="20" Height="20" Margin="0,0,0,6"
                                                  TextElement.Foreground="#7F8B97" />
                                <ContentPresenter HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Grid VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22*" /><ColumnDefinition Width="56*" /><ColumnDefinition Width="22*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Glow" Grid.Column="1" Height="4" Margin="-3,0,-3,-2" CornerRadius="2" RenderTransformOrigin="0.5,0.5" Background="#55FF3B4E" Visibility="Collapsed" />
                            <Border x:Name="Ul" Grid.Column="1" Height="2" RenderTransformOrigin="0.5,0.5" Background="#FF3B4E" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="HoverFx" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8CFF3B4E" />
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1FFF3B4E" Offset="0" /><GradientStop Color="#05FF3B4E" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Ic" Property="TextElement.Foreground" Value="#FF4D5E" />
                            <Setter TargetName="Ul" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="#A9B4BF" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="fx:Motion.Interactive" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="#0E1013" BorderBrush="#232930" BorderThickness="1" CornerRadius="4" />
                        <Border x:Name="HoverFx" Margin="1" CornerRadius="3" Background="#151A1F" Opacity="0" IsHitTestVisible="False" />
                        <Border BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#E6EDF3" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ButtonIcon" TargetType="ContentControl">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="#6E7A86" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="fx:Motion.Interactive" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="2,3">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#A9B4BF" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToggleBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" Width="34" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="#3A424B" Background="Transparent">
                        <Border x:Name="Knob" Width="10" Height="10" CornerRadius="1" Margin="2,0" HorizontalAlignment="Left" Background="#56616C" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFaint}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== lighting ===== -->
    <Style x:Key="LightPanel" TargetType="Border">
        <Setter Property="Background" Value="#0E1013" />
        <Setter Property="BorderBrush" Value="#1C2127" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9" />
    </Style>
    <Style x:Key="Swatch" TargetType="RadioButton">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="fx:Motion.Interactive" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Ring" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Visibility="Hidden" />
                        <Border Width="20" Height="20" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="#26FFFFFF" BorderThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ValueSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="#6E7A86" />
    </Style>

    <Style x:Key="FxComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#E6EDF3" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A2026" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FxComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="#090A0C" BorderBrush="#232930" BorderThickness="1,1,1,1" CornerRadius="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FxCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="#E6EDF3" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FxComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource FxComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <DockPanel Margin="9,0,9,0" IsHitTestVisible="False">
                            <Path DockPanel.Dock="Right" Data="M2.5,4.5 L6,8 L9.5,4.5" Width="12" Height="12" Stroke="#E6EDF3"
                                  StrokeThickness="1.3" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Str.FxPrefix}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="#6E7A86" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="#0E1013" BorderBrush="#232930" BorderThickness="1" CornerRadius="4" Padding="3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="2" CornerRadius="1.0" Background="{DynamicResource AccentBrush}" /></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="2" CornerRadius="1.0" Background="#232930" /></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LightSlider" TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge" /></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Width="10" Height="14" CornerRadius="2" Background="#E6EDF3" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== footer + popups ===== -->
    <Style x:Key="FooterBar" TargetType="Border">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="#16191E" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Background" Value="#07080A" />
        <Setter Property="CornerRadius" Value="0,0,10,10" />
    </Style>
    <Style x:Key="FooterText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="#A9B4BF" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="VersionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="#56616C" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#6E7A86" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PopupPanel" TargetType="Border">
        <Setter Property="Background" Value="#0E1013" />
        <Setter Property="BorderBrush" Value="#232930" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="PopupTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}" />
</ResourceDictionary>
