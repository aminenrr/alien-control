<Application x:Class="AlienControl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="AccentCyan">#00E5FF</Color>
            <Color x:Key="AccentPurple">#7C4DFF</Color>
            <SolidColorBrush x:Key="MutedText" Color="#8A95A3" />
            <SolidColorBrush x:Key="CardBg" Color="#FF23272E" />
            <SolidColorBrush x:Key="CardBorder" Color="#FF2E333B" />
            <!-- Accent brushes are replaced at runtime to follow the lighting color (MainWindow.ApplyAccent). -->
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource AccentCyan}" Offset="0" />
                <GradientStop Color="{StaticResource AccentPurple}" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AccentBrush" Color="#00D8F0" />

            <!-- Stat tile -->
            <Style x:Key="StatCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBg}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="4" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#E8EDF2" />
            </Style>
            <Style x:Key="SectionHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <SolidColorBrush x:Key="CardHover" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="CardText" Color="#C9D2DC" />
            <LinearGradientBrush x:Key="CyanChecked" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3300E5FF" Offset="0" />
                <GradientStop Color="#1000E5FF" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="RedChecked" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#38FF465A" Offset="0" />
                <GradientStop Color="#0FFF465A" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            </Style>

            <!-- Thin gradient bar under each sensor value -->
            <Style x:Key="StatBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="3" />
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="Foreground" Value="{DynamicResource AccentGradient}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="2" Background="#14FFFFFF" />
                                <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Minimize / close glyphs in the header -->
            <Style x:Key="HeaderButton" TargetType="Button">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#B8C2CC" />
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                                <!-- Icon font only on the glyph, so the tooltip keeps a normal font -->
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Plain action button styled as a card (Breathe, Wave, Off, Quit...) -->
            <Style x:Key="CardButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource CardText}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="8,4,0,4" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10" BorderThickness="1"
                                    Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segmented button (RadioButton) like the mock -->
            <Style x:Key="SegButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource CardText}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="Padding" Value="6,11" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="10" BorderThickness="1"
                                    Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CyanChecked}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Big mode tile: icon glyph (Tag) over the label, like the mock -->
            <Style x:Key="ModeButton" TargetType="RadioButton" BasedOn="{StaticResource SegButton}">
                <Setter Property="Padding" Value="6,14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="12" BorderThickness="1"
                                    Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontSize="20" HorizontalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#B8C2CC" />
                                    <ContentPresenter Margin="0,8,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CyanChecked}" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- G-Mode tile: red when on -->
            <Style x:Key="GModeButton" TargetType="RadioButton" BasedOn="{StaticResource ModeButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="12" BorderThickness="1"
                                    Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontSize="20" HorizontalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#B8C2CC" />
                                    <ContentPresenter Margin="0,8,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4D6A" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource RedChecked}" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="#FF4D6A" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Swatch" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="7" Background="{TemplateBinding Background}"
                                    BorderBrush="#30FFFFFF" BorderThickness="1" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
