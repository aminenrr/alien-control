<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AlienControl</AssemblyName>
    <RootNamespace>AlienControl</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0</Version>
    <!-- the footer and Settings show the informational version (v2.0.0-beta1.4); release.yml checks it matches the tag -->
    <InformationalVersion>2.0.0-beta1.4</InformationalVersion>
    <Product>Alien Controls</Product>
    <AssemblyTitle>Alien Controls</AssemblyTitle>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Publish (dotnet publish -r win-x64): one framework-dependent exe, ReadyToRun-precompiled for fast start.
       No compression (it unpacks into RAM) and no trimming (WPF uses reflection, trimming is unsupported). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\Sounds\**\*.wav" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AlienControl.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 2.0.0-beta1.4: WPF-UI is gone (ToolTip / TextBox / ScrollBar have Legend styles in Themes/Legend2.xaml), and the
         System.Diagnostics.PerformanceCounter package too: Microsoft.WindowsDesktop.App 8.0 already ships it (build
         review #1 and #7, the exe drops from about 11.6 MB to about 3.7 MB) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- T-Troll's alienfan-cli / alienfx-cli binaries (and their DLLs) are dropped in tools/ and shipped next to the exe. -->
  <ItemGroup>
    <None Include="tools\**\*" Exclude="tools\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
