<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AlienControl</AssemblyName>
    <RootNamespace>AlienControl</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.8.5</Version>
    <Product>Alien Controls</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- T-Troll's alienfan-cli / alienfx-cli binaries (and their DLLs) are dropped in tools/ and shipped next to the exe. -->
  <ItemGroup>
    <None Include="tools\**\*" Exclude="tools\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
